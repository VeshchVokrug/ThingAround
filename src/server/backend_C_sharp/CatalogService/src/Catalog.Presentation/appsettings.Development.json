{
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Url": "http://localhost:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "admin",
    "Password": "admin",
    "Exchanges": {
      "CatalogEventsExchange": "catalog-events",
      "CatalogCommandsExchange": "catalog-commands"
    },
    "Queues": {
      "CatalogServiceQueue": "catalog-service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=catalog_db;Username=admin;Password=admin",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "RedisOptions": {
    "InstancePrefix": "Catalog"
  }
}

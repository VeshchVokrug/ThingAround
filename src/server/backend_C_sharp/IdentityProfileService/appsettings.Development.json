{
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Url": "http://localhost:5000",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=identity_db;Username=admin;Password=admin",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Issuer": "IdentityServer",
    "Audience": "ThingAroundClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationHours": 72
  },
  "RedisOptions": {
    "InstancePrefix": "identity"
  }
}
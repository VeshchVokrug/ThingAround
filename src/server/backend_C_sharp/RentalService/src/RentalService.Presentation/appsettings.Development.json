{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Debug",
      "MassTransit.Rider": "Debug"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Url": "http://localhost:5002",
        "Protocols": "Http2"
      }
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "admin",
    "Password": "admin",
    "Exchanges": {
      "RentalEventsExchange": "rental-events",
      "CatalogEventsExchange": "catalog-events",
      "CatalogCommandsExchange": "catalog-commands"
    },
    "Queues": {
      "RentalServiceQueue": "rental-service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=rental_db;Username=admin;Password=admin",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "RedisOptions": {
    "InstancePrefix": "Rental"
  }
}
